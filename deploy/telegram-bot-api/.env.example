# Example env for always-on Local Telegram Bot API (VPS / desktop that does not sleep)
# Copy to .env on the host or export before: npm run telegram:bot-api-setup
#
# From https://my.telegram.org (your user account — not invent secrets in git)

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional — only for local curl getMe smoke tests on the host
TELEGRAM_BOT_TOKEN=

# After docker compose is up on 127.0.0.1:8081, expose HTTPS then set on CranL:
# TELEGRAM_BOT_API_URL=https://botapi.your-host.example
# (no trailing slash)
#
# Mac laptop (OrbStack) is failover only while awake — see docs/telegram-always-on-bot-api.md
