# Copy to .env (never commit .env). Prefer a SELECT-only DB role.
# Parse from DATABASE_URL: ./scripts/env-from-database-url.sh

POSTGRES_HOST=db.example.supabase.co
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=readonly_or_app_user
POSTGRES_PASSWORD=
# Supabase direct host usually needs SSL:
POSTGRES_QUERY_PARAMS=sslmode=require

# Optional local port map
TOOLBOX_PORT=5000

# After cloud deploy, set on Netlify (all production contexts):
# MCP_TOOLBOX_URL=https://YOUR_HOST/mcp
