<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- hermes serve on :9119 — wrapper skips when Desktop already owns serve. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arabicbuzz.hermes-serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__AB_WRAPPER__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__AB_HOME__/.hermes</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__AB_HOME__/Library/Logs/ArabicBuzz/hermes-serve.out.log</string>
  <key>StandardErrorPath</key>
  <string>__AB_HOME__/Library/Logs/ArabicBuzz/hermes-serve.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__AB_HOME__/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>__AB_HOME__</string>
    <key>HERMES_HOME</key>
    <string>__AB_HOME__/.hermes</string>
  </dict>
</dict>
</plist>
