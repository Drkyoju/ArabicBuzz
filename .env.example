DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arabic_buzz
# For Supabase cloud, use Project Settings → Database → URI (then: npm run setup:supabase)

# Public app URL (Netlify / PWA)
NEXT_PUBLIC_APP_URL="https://your-site.netlify.app"

# Supabase Auth (Google + Apple OAuth) — also used server-side
# Mirror URL/anon into NEXT_PUBLIC_* for the browser client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Model providers (Netlify Environment Variables)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Z.AI / Zhipu GLM (direct — not OpenRouter)
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Local / air-gap
AIR_GAPPED_MODE=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:32b
AIRGAP_ALLOWED_MODELS=qwen2.5:32b,ALLaM,deepseek-r1

# Mac local vault for PDFs / voice notes / uploads
# Default: ~/ArabicBuzz/data  — only works when the app runs on your Mac
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=

# Defaults
DEFAULT_HARNESS_MODEL=gemini-2.0-flash
NEXT_PUBLIC_DEFAULT_HARNESS_MODEL=gemini-2.0-flash
HERMES_MODEL=hermes-3-405b

# Arabic Hybrid RAG embeddings (vector(1024))
EMBEDDING_PROVIDER=cohere
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-multilingual-v3.0
BGE_M3_BASE_URL=http://localhost:11434/v1
BGE_M3_MODEL=bge-m3
BGE_M3_API_KEY=

# Messaging
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TEST_CHAT_ID=
TELEGRAM_DEFAULT_SCOPE_ID=shared-demo
TELEGRAM_DEFAULT_ORG_ID=org-demo
TELEGRAM_APPROVER_USER_ID=user-1
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_SCOPE_ID=shared-demo
WHATSAPP_DEFAULT_ORG_ID=org-demo
WHATSAPP_APPROVER_USER_ID=user-1
WHATSAPP_TEST_TO=

# Ops / compliance
CRON_SECRET=change-me
SDAIA_AUDIT_HMAC_SECRET=change-me-hmac
AUDIT_EXPORT_SECRET=
TTS_PROVIDER=openai
ELEVENLABS_API_KEY=

# Netlify (optional — Site ID + personal access token for CLI)
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# Supabase Management API (sbp_… from account/tokens — dashboard Auth config)
SUPABASE_ACCESS_TOKEN=
