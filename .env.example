# Supabase Postgres URI (Project Settings → Database → URI)
# Prefer Transaction pooler (port 6543 / pooler host) on Netlify — lib/db-url.ts
# adds pgbouncer=true automatically. Example:
# postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=
# For Supabase cloud: npm run setup:supabase

# Public app URL — production only (never localhost). Primary: CranL.
NEXT_PUBLIC_APP_URL="https://arabicbuzz-fooc9h.cranl.net"
# Optional alias used by some scripts / cron docs:
# APP_URL="https://arabicbuzz-fooc9h.cranl.net"

# Auth — set true to require login for API/workspace (multi-user)
# Production (CranL): true — force real Supabase login (no synthetic guest owner).
AUTH_REQUIRED=true

# Human-in-the-loop approvals (HITL)
# Default HITL_DISABLED=0 → governance on. Under AUTO, only delete/trash/remove
# pauses for approval (files + destructive cancels). Everything else auto-executes.
# Set HITL_DISABLED=1 for fully automatic execution (including deletes).
# Netlify: set HITL_DISABLED=0 in Site settings → Environment variables (code
# cannot change Netlify env). Live health reports hitlDisabled when wrong.
# DEFAULT_SECURITY_POSTURE=AUTO | STRICT | DANGEROUS
HITL_DISABLED=0
DEFAULT_SECURITY_POSTURE=AUTO

# Assistants / room agents — max parallel workers per room (default 8, clamp 1–20).
# Netlify function concurrency is finite; 20 burns quota/timeouts. Excess waits in queue.
ASSISTANT_MAX_PARALLEL=8
# Max concurrent assistant tasks per employee (defaults to ASSISTANT_MAX_PARALLEL).
ASSISTANT_MAX_PER_USER=8

# Supabase Auth (Google + Apple OAuth) — also used server-side
# Mirror URL/anon into NEXT_PUBLIC_* for the browser client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Same Google OAuth client as Supabase Auth → Providers → Google
# Needed to refresh Calendar tokens on the server
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Model providers (Netlify Environment Variables)
GEMINI_API_KEY=
GLM_API_KEY=
AGENTROUTER_API_KEY=
# Retired from product UI (vault-purged): OPENAI_API_KEY, OPENROUTER_API_KEY,
# TOKENROUTER_API_KEY / Kimi, PERPLEXITY_API_KEY

# OpenTelemetry / Langfuse Cloud tracing — OPTIONAL (free hobby signup, no paid plan required)
# Do NOT self-host Langfuse on Netlify. Without keys: OTel is no-op; SDAIA audit log still records actions.
# Free keys: https://cloud.langfuse.com (EU) · https://us.cloud.langfuse.com (US)
# Status UI (directors): «يحتاج مفتاح مجاني من cloud.langfuse.com» until set.
# Docs: docs/ops-spine.md
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Aliases accepted: LANGFUSE_BASEURL or LANGFUSE_BASE_URL
# LANGFUSE_BASEURL=
# Or set OTEL_* yourself (wins over LANGFUSE_* auto-wiring):
OTEL_SERVICE_NAME=arabic-buzz
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/json

# Speech-to-text (composer mic) — Arabic/Saudi ASR race
# Wave 1 (parallel race): Groq Whisper + Gemini + Willow (if URL) + Deepgram (if key)
# Wave 2: Hugging Face Arabic models (HF_TOKEN), then optional OpenAI if configured
# First plausible Arabic transcript wins after a short quality window (not blind first-byte).
#
# Timing / dialect (optional — leave empty for defaults):
# ASR_RACE_MS=18000
# ASR_QUALITY_WINDOW_MS=450
# ASR_DIALECT=saudi
# Leave ASR_PREFERRED empty for full race; set only to force one provider
# (willow|gemini|groq|deepgram|sada|cohere|openai|hf).
# ASR_PREFERRED=
#
# Free / freemium to add (never invent values — paste your own from each console):
#   HF_TOKEN          — Hugging Face (free) — wave 2 + embeddings
#   GROQ_API_KEY      — Groq free tier Whisper
#   WILLOW_STT_*      — self-host: https://github.com/toverainc/willow-inference-server
#   GEMINI_API_KEY    — already used for LLM; also mic STT in the race
# Optional paid/trial (leave empty if unused):
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-2
#
# WILLOW_STT_URL=https://host:19000/api/willow
# WILLOW_STT_TOKEN=
# WILLOW_STT_LANGUAGE=ar
# WILLOW_STT_MODEL=medium
HF_TOKEN=
GROQ_API_KEY=
# GEMINI_API_KEY (above) is also used for mic STT in the race.

# Optional local OCR (Mac / long-running host — not required on CranL)
# ENABLE_TESSERACT_OCR=true
# TESSERACT_OCR_LANG=ara+eng

# Z.AI / Zhipu GLM (direct — not OpenRouter)
GLM_API_KEY=
# Coding Pro / Quarterly plan (Claude Code, Cline, Arabic Buzz):
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
# Pay-as-you-go only (not Coding Plan quota): https://api.z.ai/api/paas/v4
# GLM_PROBE_MODEL=glm-4.5

# Optional air-gap (Mac appliance only — leave empty on Netlify)
AIR_GAPPED_MODE=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:32b
AIRGAP_ALLOWED_MODELS=qwen2.5:32b,ALLaM,deepseek-r1

# Storage — Netlify default cloud; Mac vault for large files + brain
STORAGE_BACKEND=cloud
LOCAL_STORAGE_ROOT=
# Mac sync agent (npm run storage:sync) + public tunnel
MAC_SYNC_URL=
MAC_SYNC_SECRET=
MAC_SYNC_PORT=7420
MAC_MAX_UPLOAD_BYTES=8589934592
# Browser direct upload to Mac (same tunnel URL) — bypasses Netlify body limits
NEXT_PUBLIC_MAC_UPLOAD_URL=
# When mac: search/ingest go to Mac vault only. Leave empty for cloud Drive brain.
BRAIN_PRIMARY=

# Google Drive folder used as company brain source (ملفات الجمعية) — cloud index, no Mac
# https://drive.google.com/drive/folders/1Zu2vgbR8p0f8xnn1_cTnUZwsTLHUiHhW
GOOGLE_DRIVE_BRAIN_FOLDER_ID=1Zu2vgbR8p0f8xnn1_cTnUZwsTLHUiHhW
# Canonical workspace scope for Drive RAG (search works from any room).
COMPANY_BRAIN_SCOPE_ID=shared-demo
# Owner user whose Google OAuth powers the scheduled (cron) Drive sync.
# Interactive «زامن العقل» uses the signed-in user's tokens (prefer director).
# Pin cron to ryodan71@gmail.com Supabase id:
#   DRIVE_BRAIN_OWNER_USER_ID=bc4522fe-30a5-4e7a-9a85-5ac969d7b9ca
DRIVE_BRAIN_OWNER_USER_ID=
DRIVE_BRAIN_SYNC_SECRET=

# Defaults
DEFAULT_HARNESS_MODEL=gemini-2.5-pro
NEXT_PUBLIC_DEFAULT_HARNESS_MODEL=gemini-2.5-pro
HERMES_MODEL=hermes-3-405b

# Arabic Hybrid RAG embeddings (vector(1024)) — FREE FIRST
# Auto cascade: HF_TOKEN (e5) → BGE_M3_BASE_URL → hash
# Paid Cohere ONLY if you set EMBEDDING_PROVIDER=cohere (not recommended)
EMBEDDING_PROVIDER=
# Free: Hugging Face token (same HF_TOKEN used for STT) — no paid plan
HF_EMBED_MODEL=intfloat/multilingual-e5-large
# Free self-host: https://github.com/FlagOpen/FlagEmbedding
BGE_M3_BASE_URL=
BGE_M3_MODEL=bge-m3
BGE_M3_API_KEY=
# Optional paid — leave empty
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-multilingual-v3.0

# Zoom Server-to-Server OAuth (auto-create meeting links + live status)
# https://marketplace.zoom.us/develop/create → Server-to-Server OAuth
# Scopes: meeting:write:admin, meeting:read:admin, user:read:admin
# Optional dashboard: dashboard_meetings:read:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Optional: Zoom user id/email to check for live meetings (skips listing all users)
ZOOM_HOST_USER_ID=

# Messaging
TELEGRAM_BOT_TOKEN=
# Optional: Local Bot API root for files >~20MB (Mac/VPS sidecar — NOT inside CranL image).
# Example: http://127.0.0.1:8081 or https://tunnel-to-local-bot-api
# See docs/telegram-local-bot-api.md and deploy/telegram-bot-api/
TELEGRAM_BOT_API_URL=
# Optional. If set, register webhook WITH the same value via:
#   npx tsx scripts/set-telegram-webhook.ts
# Missing X-Telegram-Bot-Api-Secret-Token is accepted (compat); wrong token is rejected.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_TEST_CHAT_ID=
TELEGRAM_DEFAULT_SCOPE_ID=shared-demo
TELEGRAM_DEFAULT_ORG_ID=org-demo
TELEGRAM_APPROVER_USER_ID=user-1
# Public t.me link shown in Settings (client)
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/alhuda14bot
# Groups: BotFather → Group Privacy → Disable if the bot must see all messages.
# With privacy ON (default), users must /ask or @mention the bot. Bind a group
# by sending /link or /start inside the group (captures negative chat id).
# Do not invent chat ids. Optional external queue only:
# TRIGGER_DEV_WEBHOOK_URL=
# WhatsApp — FREE path only (self-host bridge). Netlify cannot hold WA Web sessions.
# Prefer Evolution API / Baileys worker → POST to /api/webhooks/whatsapp
# WHATSAPP_BRIDGE_URL=https://your-evolution-host
# WHATSAPP_BRIDGE_SECRET=shared-secret
# WHATSAPP_BRIDGE_INSTANCE=arabicbuzz
# WHATSAPP_OWNER_TO=9665xxxxxxxx
# WHATSAPP_BRIDGE_OWNER_TO=9665xxxxxxxx
# WHATSAPP_TEST_TO=
# Meta Cloud API (may bill) — avoid; only if you accept fees:
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# Owner user id for channel-originated tools (Calendar/Drive/etc)
# Prefer same UUID as DRIVE_BRAIN_OWNER_USER_ID. Auto-resolves from
# google_oauth_tokens for OWNER_EMAIL / ryodan71@gmail.com when unset.
CHANNEL_OWNER_USER_ID=
TELEGRAM_OWNER_USER_ID=

# Email invites + weekly director digest «ما ينتظر قرارك»
# Resend = outbound transactional only (not inbox read).
# Org mailbox (info@…) PRIMARY path: IMAP/SMTP from UI «بريد الجمعية»
# (encrypted in DB). Optional Google Gmail OAuth remains as fallback.
# Optional vault secret for IMAP password encryption (else CRON_SECRET):
# IMAP_VAULT_SECRET=
RESEND_API_KEY=
RESEND_FROM="Arabic Buzz <onboarding@resend.dev>"
# Director allow-list (comma-separated). Always includes ryodan71@gmail.com by default.
# Anyone else who signs in is forced to employee (موظف).
DIRECTOR_EMAILS=ryodan71@gmail.com
# Recognized employees (comma-separated, case-insensitive). Merged with built-in
# defaults (hd.hk1444920@gmail.com, hd.hk2023429@gmail.com). Google OAuth only —
# no passwords. On first sign-in they get MEMBER + غرفة الفريق roster row.
# Set the same value in CranL Application → Environment if you add more staff.
EMPLOYEE_EMAILS=hd.hk1444920@gmail.com,hd.hk2023429@gmail.com
# Legacy single director inbox for Thursday digest (also treated as director if set).
# Optional: set to association mailbox after it can receive mail, e.g. info@alhuda-alhikma.sa
# (Netlify env — do not invent secrets; owner sets in Netlify UI).
DIRECTOR_EMAIL=
DIGEST_EMAIL=
DIGEST_NAME_AR=المدير التنفيذي

# ── Telegram unsolicited GROUP push (OFF by default — silence > spam) ──
# Absolute kill-switch (DEFAULT ON when unset): blocks ALL group sendMessage/
# sendDocument unless the send is inside an inbound webhook reply context.
# TELEGRAM_SILENCE_UNSOLICITED=1
# To allow opted-in cron digests later: TELEGRAM_SILENCE_UNSOLICITED=0
# Cron digests/reminders must NOT post to «عمل الجمعية» unless opted in.
# Master switch required + per-feature flag. Both default OFF when unset.
# TELEGRAM_GROUP_PUSH=1
# TELEGRAM_MORNING_DIGEST=1
# TELEGRAM_WEEKLY_GROUP_DIGEST=1
# TELEGRAM_OVERDUE_NUDGE=1
# TELEGRAM_APPOINTMENT_REMINDERS=1
# TELEGRAM_DEADLINE_REMINDERS=1
# TELEGRAM_DIRECTOR_DIGEST=1
# TELEGRAM_HEARTBEAT_PUSH=1
# TELEGRAM_SCHEDULED_TASK_PUSH=1
# TELEGRAM_IMAP_NOTIFY=1
# TELEGRAM_MAIL_ENERGY_PUSH=1
# See docs/telegram-bot-ar.md — «لا سبام للمجموعة»

# Ops / compliance (CRON_SECRET also seals audit watermarks if set)
# Schedule: POST /api/crons/runner hourly (or /api/crons/director-digest Thu) with Bearer CRON_SECRET
# Runner also prunes room_posts older than ROOM_CHAT_RETENTION_DAYS (workspace_files untouched).
CRON_SECRET=change-me
# Days to keep room/personal chat messages (1–30). Default 4. Applies to shared + personal desks.
ROOM_CHAT_RETENTION_DAYS=4
AUDIT_EXPORT_SECRET=

# One-click demo login (off by default — set true only for staging demos)
ALLOW_DEMO_LOGIN=false
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
TTS_PROVIDER=openai
ELEVENLABS_API_KEY=

# Netlify (optional — Site ID + personal access token for CLI)
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# Reliability stack (optional)
# Upstash webhook rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
WEBHOOK_RATE_LIMIT_PER_MIN=60
# Trigger-style async workflow handoff endpoint
TRIGGER_DEV_WEBHOOK_URL=
TRIGGER_DEV_WEBHOOK_SECRET=

# ── Open-source tool bridges (optional) ──
# Browser RPA — browser-use bridge on Mac OR Steel.dev cloud
# GitHub: browser-use/browser-use
# Prefer BROWSER_USE_URL; else MAC_SYNC_URL POST /task (browser-use first, Playwright fallback)
BROWSER_USE_URL=
BROWSER_USE_SECRET=
BROWSER_USE_MAX_STEPS=25
BROWSER_USE_SCRIPT=
BROWSER_ENGINE=auto
# On the Mac: pip install browser-use && playwright install chromium
# OPENAI_API_KEY (or BROWSER_USE_OPENAI_API_KEY) required by browser-use agent
STEEL_API_KEY=
STEEL_API_URL=https://api.steel.dev

# Cua Driver bridge (optional local computer/browser use — NOT inside Netlify)
# Install: https://cua.ai/cua-driver  ·  Docs: docs/cua-bridge.md
# Local: cua-driver serve && CUA_BRIDGE_SECRET=… npm run cua:bridge
# Tunnel → Netlify CUA_BRIDGE_URL (+ secret; may reuse MAC_SYNC_SECRET)
CUA_BRIDGE_URL=
CUA_BRIDGE_SECRET=
CUA_BRIDGE_PORT=7430
# CUA_DRIVER_BIN=cua-driver
# CUA_DRIVER_SOCKET=

# CloudConvert — optional paid high-fidelity Office/PDF conversion
# Free path always works: Google Drive (linked OAuth) + LibreOffice on CranL
# + OOXML replacements / text rebuild. Docs: docs/file-edit-engines.md
# Dashboard: https://cloudconvert.com/dashboard/api/v2/keys
# UI label: «اختياري مدفوع» — do NOT buy without owner approval
CLOUDCONVERT_API_KEY=

# LibreOffice — optional in Docker (INSTALL_LIBREOFFICE=1). CranL default is thin (0).
# No runtime API key. Free convert without LO: Google Drive after OAuth link.
# LIBREOFFICE_PATH=/usr/bin/soffice
# SOFFICE_PATH=/usr/bin/soffice

# Google Drive convert uses the signed-in user's OAuth (drive.file) — free.
# No CLOUDCONVERT needed. Ensure Google link from Settings → عقل الشركة.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET power OAuth (see google-oauth-ar.md).
# GOOGLE_DRIVE_BRAIN_FOLDER_ID is for company brain sync, not convert itself.

# Arabic PDF in-place replace (PyMuPDF). Local path to python with pymupdf, e.g.:
# PDF_REPLACE_PYTHON=/Users/you/ArabicBuzz/scripts/pdf-tools-venv/bin/python
PDF_REPLACE_PYTHON=

# Arabic OCR layout — Marker / Surya HTTP bridges (else Qari/Gemini cascade)
# GitHub: VikParuchuri/marker · VikParuchuri/surya
MARKER_OCR_URL=
SURYA_OCR_URL=
MARKER_OCR_SECRET=
SURYA_OCR_SECRET=
QARI_OCR_URL=
QARI_OCR_SECRET=
QARI_OCR_MODEL=NAMAA-Space/Qari-OCR-v0.3-VL-2B-Instruct
# OCR cascade (free-first): Paddle Arabic → Tesseract mac → Qari → Gemini
# Convert: same Paddle/Tesseract first, then Gemini Flash → stronger → STOP (Mistral opt-in).
OCR_GEMINI_FLASH_MODEL=gemini-2.5-flash
OCR_GEMINI_STRONG_MODEL=gemini-3.1-pro
# Back-compat alias for Flash when OCR_GEMINI_FLASH_MODEL unset:
OCR_GEMINI_MODEL=gemini-2.5-flash

# PaddleOCR Arabic — PRIMARY when available (Apache-2.0). NOT in thin CranL image.
# Preferred: Mac hop POST /ocr/paddle via MAC_SYNC_URL (health.tools.paddle=true).
# Alternate sidecar:
#   PADDLE_OCR_URL=https://your-paddle-sidecar
# See deploy/paddle-ocr/ and docs/mac-ocr-tesseract.md
# Local python only when paddleocr is already installed:
#   ENABLE_PADDLE_OCR=1
PADDLE_OCR_URL=
PADDLE_OCR_SECRET=
ENABLE_PADDLE_OCR=0
PADDLE_OCR_LANG=ar
PADDLE_OCR_PYTHON=
# PADDLE_OCR_SKIP_MAC=1

# Optional paid OCR AFTER free cascade — never invent keys; leave empty if unused.
# Docs: https://docs.mistral.ai/capabilities/document_ai/basic_ocr/
# Mistral OCR is OFF by default for convert. Opt-in only:
# CONVERT_ALLOW_MISTRAL=1
# MISTRAL_API_KEY=
# OCR_MISTRAL_MODEL=mistral-ocr-latest
CONVERT_ALLOW_MISTRAL=0

# Workflow automation — Activepieces / n8n webhooks
# GitHub: activepieces/activepieces · n8n-io/n8n
ACTIVEPIECES_WEBHOOK_BASE=
N8N_WEBHOOK_BASE=
WORKFLOW_WEBHOOK_URL=
WORKFLOW_WEBHOOK_SECRET=

# MCP Toolbox for Databases (googleapis/mcp-toolbox) — replaces dead postgres MCP
# Deploy Toolbox as a container (Fly/Railway/VPS) with Streamable HTTP, then:
# Example: https://toolbox.example.com/mcp
# Local stdio: npx -y @toolbox-sdk/server --prebuilt=postgres --stdio (Mac only)
# See docs/ops-spine.md — prefer read-only SQL tools for association reports.
MCP_TOOLBOX_URL=

# Ops bridge / Supergateway (Mac or VPS) — packages/ops-bridge
# Stdio MCP servers (filesystem, playwright, markitdown, github, …) cannot run
# inside Netlify functions — wrap with Supergateway or use Mac sync agent.
#   node packages/ops-bridge/bin/ab-ops-bridge.mjs list
#   npm run storage:sync   # preferred for vault + browser-use + markitdown
# MCP remote servers (JSON array of {id,name,url}) — HTTP/SSE only on Netlify
# Example: [{"id":"github","name":"GitHub","url":"https://your-tunnel/mcp"}]
# GitHub: modelcontextprotocol/servers · Catalog UI: Settings → أدوات MCP
MCP_REMOTE_SERVERS=
MCP_GITHUB_URL=
MCP_MARKITDOWN_URL=
# Auto-connect free catalog defaults (context7 only when MCP_AUTO_CONTEXT7=1).
# Firecrawl MCP auto-connects only when FIRECRAWL_API_KEY is set (optional upgrade).
MCP_AUTO_DEFAULTS=1
# Anybrowse auto-connect — opt-in only. Set to 1 to enable.
MCP_AUTO_ANYBROWSE=
# Context7 (developer library docs) stays off unless set to 1 — not useful for
# association staff and it adds tool noise to every chat turn.
MCP_AUTO_CONTEXT7=

# --- Web search & crawl: FREE PATH FIRST (no keys required) ---
# web_search: DuckDuckGo HTML/lite + Wikipedia + site:gov.sa (built-in)
# web_fetch / ingest_url_to_brain: Jina Reader (r.jina.ai) + plain fetch
# Optional upgrades below — leave empty on Netlify; do NOT invent fake keys.
#
# Brave Search (optional free-tier signup): https://api-dashboard.search.brave.com
BRAVE_API_KEY=
BRAVE_MCP_URL=
# Firecrawl (optional paid-leaning upgrade): https://www.firecrawl.dev
FIRECRAWL_API_KEY=
FIRECRAWL_MCP_URL=

# ZenMux (OpenAI-compatible gateway) — optional; research / multi-model routing
# Docs: https://zenmux.ai/docs/guide/quickstart
ZENMUX_API_KEY=
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
# Optional remote MCP URLs (also: MCP_<ID>_URL e.g. MCP_SLACK_URL)
SUPABASE_MCP_URL=
# Optional: taylorwilsdon/google_workspace_mcp remote URL (native Gmail/Sheets tools preferred)
MCP_GOOGLE_WORKSPACE_URL=
# Ops-bridge extras after `ab-ops-bridge.mjs fetch|playwright|time|sequential-thinking`
MCP_FETCH_URL=
MCP_PLAYWRIGHT_URL=
MCP_TIME_URL=
MCP_SEQUENTIAL_THINKING_URL=
MCP_MEMORY_KG_URL=
MCP_FILESYSTEM_URL=

# Cursor local MCP (.cursor/mcp.json) — set in your shell profile if needed:
#   GITHUB_PERSONAL_ACCESS_TOKEN=…   # github MCP
#   BRAVE_API_KEY=…                  # brave-search MCP (free tier)
#   IMAP_HOST / IMAP_USER / IMAP_PASS  # optional IMAP MCP (Cursor only; send off by default)
#   DATABASE_URL=…                   # optional postgres-toolbox MCP (Cursor stdio)
# Supabase MCP in Cursor uses mcp-remote → https://mcp.supabase.com/mcp (OAuth; read_only)
# Optional stubs (copy from .cursor/mcp.stubs.example.json): Google Workspace, Telegram userbot, Notion
# Docs: docs/skills-and-mcp.md

# Optional IMAP for Cursor MCP only (not used by Netlify product Gmail tools)
IMAP_HOST=
IMAP_USER=
IMAP_PASS=
# SMTP_SEND_ENABLED=false is hard-coded in .cursor/mcp.json for safety

# Optional Telegram userbot / deep group archive (Mac MTProto — NOT the product grammy bot)
# From https://my.telegram.org — required ONLY to scan ancient group history the bot never received.
# One-time: npm run telegram:mtproto-login  (never posts to the group chat)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_MCP_DIR=

# Optional Notion MCP (Cursor)
NOTION_TOKEN=

# Optional tldraw license (free for most use)
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Supabase Management API (sbp_… from account/tokens — dashboard Auth config)
SUPABASE_ACCESS_TOKEN=
