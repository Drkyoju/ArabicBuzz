# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests/evals/last-report.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local scratch / PDF experiments (never commit)
/tmp/

# local PDF Python tooling (install with: python3 -m venv scripts/pdf-tools-venv && pip install pymupdf)
/scripts/pdf-tools-venv/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated Fly app config (secrets stay in `fly secrets`)
/deploy/telegram-bot-api/fly.toml

# local agent tooling / caches
.agents/
.claude/
.windsurf/
.openclaw/

# vercel
.vercel

# netlify
.netlify

# local Mac vault (PDFs, voice notes) — also ~/ArabicBuzz/data
/data
/ArabicBuzz

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
